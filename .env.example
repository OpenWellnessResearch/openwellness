# Copy this file to .env at the repository root, next to docker-compose.yml
# (never commit .env). Services load that file whether they are started by
# docker compose (env_file) or directly with uvicorn or celery from any
# directory. Set OPENWELLNESS_ENV_FILE to an absolute path to use a different
# file. Real environment variables override .env values, which override code
# defaults.
# Shared datastore, Redis and Postgres names are defined in
# backend/core/src/openwellness_core/infrastructure/config/settings.py;
# service-specific names (API_*, API_AUTH_*, SMTP_*, CELERY_*) live in the
# service config modules.

# Couchbase — external instance reachable via outbound access.
COUCHBASE_URL=
COUCHBASE_USERNAME=
COUCHBASE_PASSWORD=
COUCHBASE_BUCKET_NAME=

# Mongo — opserver publishes it on the VM host; reach it via host.docker.internal.
# For a direct run on the host, use localhost instead of host.docker.internal.
# The app user authenticates against the app DB itself, so authSource = <db> (NOT admin).
MONGO_URL=mongodb://<user>:<pass>@host.docker.internal:27017/?authSource=<db>
MONGO_DB=<db>

# Sync Gateway.
SYNC_GATEWAY_URL=

# API metadata.
API_TITLE=OpenWellness API

# Default App-entity identifiers stamped by AppRepository.create_app
# (unlisted-link apps). Deployment-specific; leave empty to skip.
APP_STORE_ID=
APP_IOS_BUNDLE_ID=
APP_ONE_SIGNAL_APP_ID=

# Redis — OTP codes and rate limits; docker-compose.yml points the api at the
# compose redis service.
REDIS_URL=redis://localhost:6379/0

# Celery (scheduler) — broker + result backend. Values are for direct runs on
# the host; docker-compose.yml points the scheduler at the compose redis
# service. Names map to backend/scheduler/.../config.py.
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
